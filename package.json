{
  "name": "openhiggsfield-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "brand": "node scripts/build-brand-assets.mjs",
    "electron:dev": "electron electron --dev",
    "electron:build": "node scripts/build-electron.mjs",
    "electron": "node scripts/build-electron.mjs && electron electron",
    "dist:win": "node scripts/build-electron.mjs && electron-builder --win",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "@vercel/blob": "^2.8.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "ai.openhiggsfield.desktop",
    "productName": "OpenHiggsfield",
    "directories": {
      "app": "electron",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "electron-server",
        "to": "server"
      },
      {
        "from": "electron-server/node_modules",
        "to": "server/node_modules"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "public/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon-512.png"
    },
    "files": [
      "**/*",
      "!node_modules/**/*"
    ]
  }
}
